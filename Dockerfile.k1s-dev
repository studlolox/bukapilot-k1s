# ==============================================================================
# Bukapilot K1S - Hermetic Development & Test Container
# Base Distribution: Ubuntu 20.04 LTS (Canonical Openpilot 0.8 Baseline)
# Python Target: Python 3.8.10
# ==============================================================================
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV ZMQ=1
ENV OPENPILOT_ENV=1
ENV NOSENSOR=1
ENV PYTHONPATH=/tmp/openpilot

# Set locale
RUN apt-get update && apt-get install -y --no-install-recommends locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install build toolchain and system libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    bzip2 \
    ca-certificates \
    capnproto \
    clang \
    cmake \
    curl \
    git \
    libarchive-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libbz2-dev \
    libcapnp-dev \
    libcurl4-openssl-dev \
    libeigen3-dev \
    libffi-dev \
    libglib2.0-0 \
    liblzma-dev \
    libomp-dev \
    libsqlite3-dev \
    libssl-dev \
    libtool \
    libusb-1.0-0-dev \
    libzmq3-dev \
    llvm \
    make \
    pkg-config \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    scons \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to compatible baseline
RUN python3 -m pip install --no-cache-dir --upgrade pip==21.3.1

# Install exact python dependencies matching Pipfile/Pipfile.lock
RUN python3 -m pip install --no-cache-dir \
    atomicwrites==1.4.1 \
    cffi==1.15.1 \
    crcmod==1.7 \
    cryptography==37.0.4 \
    Cython==0.29.36 \
    flake8==4.0.1 \
    hexdump==3.3 \
    Jinja2==3.1.2 \
    json-rpc==1.13.0 \
    libusb1==2.0.1 \
    lru-dict==1.1.8 \
    numpy==1.21.6 \
    parameterized==0.8.1 \
    Pillow==9.2.0 \
    psutil==5.9.1 \
    pycapnp==1.1.0 \
    pycryptodome==3.15.0 \
    PyJWT==2.4.0 \
    pyserial==3.5 \
    pytest==7.1.2 \
    pytest-xdist==2.5.0 \
    python-dateutil==2.8.2 \
    PyYAML==6.0 \
    pyzmq==22.3.0 \
    requests==2.28.1 \
    scipy==1.7.3 \
    setproctitle==1.2.3 \
    six==1.16.0 \
    timezonefinder==5.2.0 \
    tqdm==4.64.0 \
    urllib3==1.26.11 \
    utm==0.7.0 \
    websocket-client==1.3.3

WORKDIR /tmp/openpilot

CMD ["/bin/bash"]
